  else if ((argc == 4) && (strcmp(argv[1], "-o") == 0)) {
    ExtractNumber(&offset, argv[2]);
    ConvertELF(argv[3], offset);
  }
  else {
    fprintf (
# 409 "img2srec.c" 3 4
            stderr
# 409 "img2srec.c"
                  , "Usage: img2srec [-o offset] <image>\n");
  }

  return 0;
}
